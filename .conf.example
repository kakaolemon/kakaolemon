[app]
APP_NAME="Kakaolemon"
APP_VERSION="1.0.0"
APP_HOST=http://localhost
APP_PORT=2020
APP_KEY=

[database]
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kakaolemon

[email]
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USERNAME=user@example.com
EMAIL_PASSWORD=

[minio]
MINIO_HOST=
MINIO_USER=
MINIO_PASS=
MINIO_BUCKET=

[response]
ACCESS_CONTROLL_ALLOW_ORIGIN=*
ACCESS_CONTROLL_ALLOW_METHOD=GET,POST,PUT,DELETE,OPTIONS
ACESS_CONTROLL_ALLOW_HEADERS=Content-Type,Authorization,Accept,Origin,User-Agent,Referer,X-Requested-With,X-CSRF-Token
RESPONSE_CONTENT_TYPE=application/json

[identity]
IDENTITY_NAME=Kakaolemon
